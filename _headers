# Cloudflare Pages headers.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

# Per-visitor geo answer - must never be cached by a CDN, proxy or browser.
/api/*
  Cache-Control: no-store

# HTML is revalidated every time so a deploy is picked up immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# The service worker must never be served stale, or it can never update itself.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# consent.js and styles.css change with deploys; the service worker serves them
# stale-while-revalidate, so a short browser TTL is enough.
/styles.css
  Cache-Control: public, max-age=3600
/consent.js
  Cache-Control: public, max-age=3600

# Images and icons are effectively static.
/*.png
  Cache-Control: public, max-age=604800
/*.ico
  Cache-Control: public, max-age=604800
/site.webmanifest
  Cache-Control: public, max-age=86400
